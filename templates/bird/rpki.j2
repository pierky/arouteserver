{% from 'macros.j2' import write_prefix_list %}
# ---------------------------------------------------------
# RPKI

{% set roas_used = cfg.filtering.rpki_bgp_origin_validation.enabled or
	cfg.filtering.irrdb.use_rpki_roas_as_route_objects.enabled %}
{% set aspas_used = cfg.filtering.rpki_aspa_verification.enabled and
	aspa_supported_by_target %}
{% if roas_used or aspas_used %}
{%   if "2.0.0"|target_version_le -%}
{%     if cfg.rpki_roas.source == "rtr" %}
# ROAs can be loaded using an external tool: rtrllib
# https://github.com/rtrlib/bird-rtrlib-cli
{%     endif %}
roa table RPKI {
{%     for roa in rpki_roas %}
	roa {{ roa.prefix }} max {{ roa.max_len }} as {{ roa.asn }};
{%     endfor %}
};
{%   else -%}
{%     if roas_used %}
roa4 table RPKI4;
roa6 table RPKI6;
{%     endif %}
{%     if aspas_used %}
aspa table ASPA;
{%     endif %}
{#
     The file containing the configuration of the RTR sessions is
     included only once, even when it's used to gather both the ROAs
     and the ASPAs.
     Please note: ASPAs are carried only by version 2 of the RTR
     protocol, so the 'protocol rpki' configured within that file must
     be set to negotiate it ('min version 2;').
#}
{%     if (roas_used and cfg.rpki_roas.source == "rtr") or
	(aspas_used and cfg.rpki_aspas.source == "rtr") %}
{{ "rpki_rtr_config"|include_local_file -}}
{%     endif %}
{%     if roas_used and cfg.rpki_roas.source != "rtr" %}
{%       for this_ip_ver in list_ip_vers %}
protocol static {
    roa{{ this_ip_ver }} { table RPKI{{ this_ip_ver }}; };
{%         for roa in rpki_roas|selectattr("prefix", "is_ipver", this_ip_ver) %}
    route {{ roa.prefix }} max {{ roa.max_len }} as {{ roa.asn }};
{%         endfor %}
}
{%       endfor %}
{%     endif %}
{%     if aspas_used and cfg.rpki_aspas.source != "rtr" %}
protocol static {
    aspa { table ASPA; };
{%       for aspa in rpki_aspas %}
{%         if aspa.providers %}
    route aspa {{ aspa.customer_asn }} providers {{ aspa.providers|join(", ") }};
{%         else %}
    route aspa {{ aspa.customer_asn }} transit;
{%         endif %}
{%       endfor %}
}
{%     endif %}
{%   endif -%}
{% else %}
# RPKI not used.
{% endif %}
